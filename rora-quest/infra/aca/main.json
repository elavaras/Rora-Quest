        "description": "Container image tag to deploy (e.g. latest or a git sha)"
      }
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Entra app Client ID"
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "organizations",
      "metadata": {
        "description": "Tenant mode — use \"organizations\" for multi-tenant work/school accounts"
      }
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Azure Container Registry"
      }
    },
    "acrUsername": {
      "type": "string",
      "metadata": {
        "description": "ACR admin username used by Container Apps to pull images"
      }
    },
    "acrPassword": {
      "type": "securestring",
      "metadata": {
        "description": "ACR admin password used by Container Apps to pull images"
      }
    },
