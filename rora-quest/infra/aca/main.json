                  "name": "EntraAuth__TenantId",
                  "value": "[parameters('entraTenantId')]"
                },
                {
                  "name": "EntraAuth__CallbackPath",
                  "value": "/signin-oidc"
                },
                {
                  "name": "EntraAuth__SignedOutCallbackPath",
                  "value": "/signout-callback-oidc"
                },
                {
                  "name": "Cors__AllowedOrigins",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'rora-quest-web'), '2023-05-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "EntraAuth__ClientSecret",
                  "secretRef": "kv-ref-entra-secret"
                },
                {
                  "name": "ConnectionStrings__Postgres",
                  "secretRef": "kv-ref-pg-connstr"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 5000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 5000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http-scaler",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('rora-quest-env-{0}', parameters('environment')))]",
        "[resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "rora-quest-web",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('rora-quest-env-{0}', parameters('environment')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "http"
          },
          "registries": [
            {
              "server": "[format('{0}.azurecr.io', parameters('acrName'))]",
              "username": "[parameters('acrUsername')]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('acrPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "[format('{0}.azurecr.io/rora-quest-web:{1}', parameters('acrName'), parameters('imageTag'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http-scaler",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', 'rora-quest-api')]",
        "[resourceId('Microsoft.App/managedEnvironments', format('rora-quest-env-{0}', parameters('environment')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment')))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment'))), resourceId('Microsoft.App/containerApps', 'rora-quest-api'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', 'rora-quest-api'), '2023-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', 'rora-quest-api')]",
        "[resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment')))]"
      ]
    }
  ],
  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'rora-quest-api'), '2023-05-01').configuration.ingress.fqdn)]"
    },
    "webUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', 'rora-quest-web'), '2023-05-01').configuration.ingress.fqdn)]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[format('rora-kv-{0}', parameters('environment'))]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment'))), '2023-07-01').vaultUri]"
    }
  }
}