            },
            {
              "name": "kv-ref-pg-connstr",
              "keyVaultUrl": "[format('{0}secrets/PostgresConnectionString', reference(resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment'))), '2023-07-01').vaultUri)]",
              "identity": "system"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[format('{0}.azurecr.io/rora-quest-api:{1}', parameters('acrName'), parameters('imageTag'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "Production"
                },
                {
                  "name": "EntraAuth__ClientId",
