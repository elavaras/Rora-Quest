    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[format('rora-quest-logs-{0}', parameters('environment'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[format('rora-quest-env-{0}', parameters('environment'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('rora-quest-logs-{0}', parameters('environment'))), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('rora-quest-logs-{0}', parameters('environment'))), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('rora-quest-logs-{0}', parameters('environment')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "rora-quest-api",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('rora-quest-env-{0}', parameters('environment')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 5000,
            "transport": "http"
          },
          "registries": [
            {
              "server": "[format('{0}.azurecr.io', parameters('acrName'))]",
              "username": "[parameters('acrUsername')]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('acrPassword')]"
            },
            {
              "name": "kv-ref-entra-secret",
              "keyVaultUrl": "[format('{0}secrets/EntraClientSecret', reference(resourceId('Microsoft.KeyVault/vaults', format('rora-kv-{0}', parameters('environment'))), '2023-07-01').vaultUri)]",
